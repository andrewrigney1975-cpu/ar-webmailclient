{
  "appId": "com.despatch.mobile",
  "appName": "Dispatch",
  "webDir": "dist",
  "loggingBehavior": "none",
  "android": {
    "minWebViewVersion": 140
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    },
    "CapacitorSQLite": {
      "androidIsEncryption": true,
      "androidBiometric": {
        "biometricAuth": false
      }
    }
  }
}
